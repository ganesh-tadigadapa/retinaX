# Point the UI at the API.
#
# Use 127.0.0.1, not "localhost". On macOS "localhost" resolves to both ::1 and
# 127.0.0.1, and the API binds IPv4 only, so the browser tries ::1 first and has to fail
# over -- which looks like calls that intermittently stall while curl works fine.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8080


# Sign in with Google: the OAuth "Web application" client ID. Public by design.
# Must equal GOOGLE_CLIENT_ID in the API's .env. If unset, the page asks the API for
# it (GET /v1/auth/config), so setting it only in the API also works.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=1234567890-abc123.apps.googleusercontent.com

# ---------------------------------------------------------------------------
# What is deliberately NOT here
# ---------------------------------------------------------------------------
# No secrets of any kind. Anything prefixed NEXT_PUBLIC_ is compiled into the
# JavaScript bundle and is readable by anyone who opens the site. There is no
# Google client SECRET in this app at all: the browser gets an ID token from
# Google and the API verifies it against Google's public certificates.
